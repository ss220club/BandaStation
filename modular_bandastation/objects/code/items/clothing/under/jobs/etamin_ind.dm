// MARK: Etamin ind.
/obj/item/clothing/under/rank/etamin_ind
	icon = 'modular_bandastation/objects/icons/obj/clothing/under/etamin_ind.dmi'
	worn_icon = 'modular_bandastation/objects/icons/mob/clothing/under/etamin_ind.dmi'
	lefthand_file = 'modular_bandastation/objects/icons/mob/inhands/clothing_left_hand.dmi'
	righthand_file = 'modular_bandastation/objects/icons/mob/inhands/clothing_right_hand.dmi'
	can_adjust = FALSE

/obj/item/clothing/under/rank/etamin_ind/suit
	name = "Etamin Ind. suit"
	desc = "Удобный рабочий костюм сотрудников корпорации Etamin Industry. Все то же удобство, но в прекрасной гамме угольных оттенков."
	icon_state = "ei_suit"

/obj/item/clothing/under/rank/etamin_ind/suit/maid
	name = "Etamin Ind. maid suit"
	desc = "Костюм горничной от Etamin Industry. У нас все еще сомнения по законности наших товаров."
	icon_state = "ei_suit_maid"

/obj/item/clothing/under/rank/etamin_ind/skirt
	name = "Etamin Ind. skirt"
	desc = "Удобная рабочая юбка сотрудников корпорации Etamin Industry. Запачкать её будет крайне сложно, так что вы всегда будете прелестны и очаровательны. Даже если руки по локоть в крови."
	icon_state = "ei_skirt"

/obj/item/clothing/under/rank/etamin_ind/skirt/white
	name = "Etamin Ind. white skirt"
	desc = "Удобная белая рабочая юбка сотрудников корпорации Etamin Industry. Это что-то инновационное, а сам глава пиара признался, что не знает, будет ли она пользоваться успехом."
	icon_state = "ei_skirt_white"

/obj/item/clothing/under/rank/etamin_ind/skirt_alt
	name = "Etamin Ind. luxurious skirt"
	desc = "Стильная юбка сотрудников корпорации Etamin Industry. Линейка коллекции \"Золотое Солнце\"."
	icon_state = "ei_skirt_alt"

/obj/item/clothing/under/rank/etamin_ind/skirt_top
	name = "Etamin Ind. skirt and top"
	desc = "Стильная юбка и топ от Etamin Industry. Открытый живот, плечи и все, что ниже колен? Вы уверены? Этот мир определенно не готов к такому открытому стилю, но может, мы положим начало чему-то большему?"
	icon_state = "ei_skirt_top"

/obj/item/clothing/under/rank/etamin_ind/formal
	name = "Etamin Ind. formal suit"
	desc = "Деловой костюм от корпорации Etamin Industry. Лучшее качество в Галактике!"
	icon_state = "ei_formal"

/obj/item/clothing/under/rank/etamin_ind/combat
	name = "Etamin Ind. tactical suit"
	desc = "Боевая тактическая униформа охранного подразделения корпорации Etamin Industry. Высокие технологии на страже ваших вкладов."
	icon_state = "ei_combat"
	inhand_icon_state = "ei_suit"

/obj/item/clothing/under/rank/etamin_ind/combat/white
	name = "Etamin Ind. tactical suit"
	desc = "Боевая тактическая униформа белого цвета охранного подразделения корпорации Etamin Industry. Она сохранит каждое пятнышко крови, а потому вас будет очень легко заштопать по следу вашей крови на ней."
	icon_state = "ei_combat_white"
