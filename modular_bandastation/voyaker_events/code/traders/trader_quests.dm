	if(H.put_in_hands(M))
		to_chat(H, span_notice("Фейшн вручает вам пистолет Пустынный Орёл."))
	else
		M.forceMove(get_turf(H))
		to_chat(H, span_notice("Робинсон кладёт пистолет Пустынный Орёл у ваших ног."))

/datum/trader_quest/fashion_targets/on_target_killed(mob/living/carbon/human/H, mob/living/victim)
	if(!ishuman(victim))
		return FALSE
	var/mob/living/carbon/human/target = victim
	if(!istype(get_area(target), /area/new_sydney/coast))
		return FALSE
	if(!istype(target.w_uniform, /obj/item/clothing/under/syndicate))
