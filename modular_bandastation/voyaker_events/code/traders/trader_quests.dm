#define COOLDOWN_BLACKBOX "samopal_blackbox"
#define TRADER_ACTION_PHONEBOX "samopal_phonebox"

/datum/trader_quest
	var/name = "Quest"
	var/description = ""
	var/context = ""
	var/reward_money = 0
	var/reward_rep = 0
	var/progress = 0
	var/goal = 1
	var/id = "quest"
	var/blocks_other_quests = FALSE
	proc/start(mob/living/carbon/human/H)
		return

/datum/trader_quest/proc/can_complete(mob/living/carbon/human/H, obj/item/I)
	return FALSE

/datum/trader_quest/proc/on_target_killed(mob/living/carbon/human/H, mob/living/victim)
	return FALSE

/datum/trader_quest/proc/add_progress(mob/living/carbon/human/H, trader_id, amount = 1)
	progress += amount
	if(progress >= goal)
		complete(H, trader_id, null)

/datum/trader_quest/proc/complete(mob/living/carbon/human/H, trader_id, obj/item/I)
	if(I)
		qdel(I)
	var/obj/item/card/id/id_card = H.get_idcard(TRUE)
	if(id_card?.registered_account)
		id_card.registered_account.adjust_money(reward_money)
	if(trader_id)
		H.add_trader_rep(trader_id, reward_rep)
		H.trader_quests -= trader_id
	H.completed_trader_quests += id
	to_chat(H, span_nicegreen("Задание выполнено. Получена награда: [reward_money] кредитов и [reward_rep] очков репутации."))
	playsound(H, 'sound/machines/synth/synth_yes.ogg', 60, TRUE)

/datum/trader_quest/proc/fail(mob/living/carbon/human/H, trader_id, reason = "")
	H.trader_quests -= trader_id
	if(trader_id)
		H.add_trader_rep(trader_id, -3)
	if(length(reason))
		to_chat(H, span_warning(reason))
	else
		to_chat(H, span_warning("Задание провалено."))
	playsound(H, 'sound/machines/synth/synth_no.ogg', 60, TRUE)

/datum/trader_quest/proc/on_enter_area(mob/living/carbon/human/H, area/A)
	return

/datum/trader_quest/proc/on_other_quest_taken(mob/living/carbon/human/H, trader_id)
	return

/datum/trader_quest/proc/on_any_human_killed(mob/living/carbon/human/killer, mob/living/carbon/human/victim)
	return

/datum/trader_quest/proc/on_forest_bunker_open(mob/living/carbon/human/H)
	return

/datum/trader_quest/samopal_medal
	name = "Старая медаль"
	id = "samopal_medal"
	description = "Вольно, салага. Работу, гришь, ищешь? Да уж, много теперь вас стало таких - вольнопашцев, как говна за баней. Ну ладно ты, не сердись так - у нас это неорусским юмором называется. Пока не могу поручить тебе ничего серьёзного, ты только на ноги встал, но вот халтурку подкинуть - всегда можно. Как раз растрясешь жирок, проветришься, красотами полюбуешься... хе-хе. Моих ребят под Новым Сиднеем много полегло, хочется от них хоть какую-то память заиметь. Помню перед десантом на планету их медалями награждали, ещё за прошые наши заслуги по обезглавливанию федератской мрази. Найди мне одну такую - я буду тебе благодарен."
	context = "Цель: Найти или сделать любую медаль и принести Самопалу."
	reward_money = 250
	reward_rep = 2

/datum/trader_quest/samopal_medal/can_complete(mob/living/carbon/human/H, obj/item/I)
	return istype(I, /obj/item/clothing/accessory/medal)

/datum/trader_quest/samopal_vtol
	name = "Падение Федеративного ястреба"
	id = "samopal_vtol"
	description = "О, явился не запылился! Однако порадовал ты немного меня тем, что медальку принёс. Но теперь настало время о серьезных делах поговорить. Вижу, что калач ты тертый, раз до сих пор на ногах держишься, да ещё и в Пустошах не свалился. Это здорово.  Билет, гришь, домой хочешь себе организовать? Я тебе что, касса космического вокзала, что ли? Никак не покинуть планету, точно тебе говорю. Федератские крысы решили после последней эвакуации орбитальную блокаду поставить, мол, видите ли, боятся они, что аномальная нечисть с планеты - на их корабли сунется. Но я ведь знаю, что это они для красного словца сказали - так, чтобы предлог придумать! Так, значится, слушай меня сюда, боец! Мне тут одна птичка залетная недавно нашептала, что на Побережье - упала птичка покрупнее. Хочешь меня спросить, что такого удивительного в упавшем истребителе? Мне сказали, что конкретно эта - упала прям в аккурат после взрыва на станции, и что летела она как раз оттуда! А значит её не наши бойцы сбили, а скорее всего она сама упала - электроника навернулась от взрыва, иль ещё чего, аномальной энергии ого-го как вышло ведь! Так вот, на борту таких обычно чёрные ящики устанавливают - да ты ведь не зелень косматая, сам должен понимать! Поэтому достань-ка мне этот ящичек, чтобы мои спецы над ним покумекали и вытащили всю заветную инфу."
	context = "Цель: Достать чёрный ящик из упавшего истребителя. Его видели на восточном краю Побережья."
	reward_money = 300
	reward_rep = 3

/datum/trader_quest/samopal_vtol/can_complete(mob/living/carbon/human/H, obj/item/I)
	return istype(I, /obj/item/blackbox)

/datum/trader_quest/samopal_spiders
	name = "Беда - не приходит одна"
	id = "samopal_spiders"
	description = "Прилетел, соколик! Ну, рассказывай, как твоё ничего - волдыри от ядерной прожарки ещё не мучают? Хе-хе! А, ты мне пришёл на уши присесть по поводу чёрного ящика. Ну, значится, смотри, какой расклад. Ящик-то мы вскрыли, вопли федератской падали послушали - и знаешь, что выяснилось? Что взрыва на внешней обшивки станции не было! А что это значит? Что федератские оползухи пробрались туда и диверсией ядерный блок подорвали, точно тебе говорю! Я как вчера помню - мне ведь командование тогда приказало караул ночной поменять. Они видать как раз выждали, суки, момент, когда наши разведчики не наблюдали за периметром возле станции - и просочились туда! Но ладно, это пока всё раздувание воздуха - нам конкретные доказательства нужны! Вот если мы с тобой планы диверсии или чертежи взрывчаток этих тварей найдём… Слушай, есть у меня тут одна мыслишка. До ядерки здесь у федератов была военная база секретная, ну Орион-15 которая. Так вот! Думается мне, что там-то мы заветные планы и найдём. Не думаю, что они их успели оттуда свистнуть - на базу ведь то мародерки нападали, то твари - ну вообщем Марди-гра во всех красках там происходило. И вот как раз за тварей хочу тебя попросить - постреляй там этих мразей восьмилапых, чтобы мои люди смогли на базу спокойно пройти, а сам пока на базу не суйся! Пусть там себе другие архаровцы резвятся и глотки друг другу почём зря грызут."
	context = "Цель: Убить 5 песчаных пауков в районе Посёлка. Условие провала: Заход на территорию военной базы Орион-15."
	goal = 5
	reward_money = 500
	reward_rep = 5

/datum/trader_quest/samopal_spiders/on_target_killed(mob/living/carbon/human/H, mob/living/victim)
	if(!istype(victim, /mob/living/basic/spider/sand))
		return FALSE
	if(!istype(get_area(victim), /area/new_sydney/village))
		return FALSE
	return TRUE

/datum/trader_quest/samopal_spiders/on_enter_area(mob/living/carbon/human/H, area/A)
	if(istype(A, /area/new_sydney/military_base))
		fail(H, TRADER_SAMOPAL, "Задание провалено. Вы нарушили указание Самопала и проникли на военную базу. Репутация снижена на -3.")

/datum/trader_quest/samopal_letter
	name = "Абонент недоступен"
	id = "samopal_letter"
	description = "Ну как, удалось тварей покошмарить? Ай, молоток! Я в тебе не сомневался, боец. Мои тимуровцы уже пошли осматривать территорию военки и искать путь захода. А я тебя пока другим поручением займу. Ты наверное уже успел увидеть, какой скромный бизнес я решил в Пустошах организовать, хе-хе… Ну а что? Жизнь тут не сахар, да и чая нигде рядом нет. Нужно же как то выживать тут, правильно? Вот я и подрядил ребят наладить поставки списанных стволов, которые у нас долгое время на складах под станцией пылились - в Пустошах иной раз даже ржавая валына шкуру может спасти. А если боец грамотный и у него не чека от гранаты вместо башки - он ещё и в порядок её приведёт как следует сам. Но ладно, что-то я тебе совсем тут по ушам байками езжу… Под меня тут копать начали, понимаешь? Кому-то очень не нравится, что я ребятам стволы отпускаю по ценнику ниже, чем у остальных - и хочет таки попытаться прикрыть мою лавочку. Я этой наглости никак не могу спуску дать. Есть у меня подозреньице, что за собака сутулая и рыжая это могла организовать - но как раз тебе это и предстоит выяснить. Обычно мои спецы их частоты прослушивают - но в последнее время что-то совсем глухо на них! И тут я подумал - может они друг другу команды посылают по телефонам? Да чего ты ржёшь тут? Телефонные будки и до войны - хорошим средством связи были. А теперь они и вовсе надёжным средством связи стали - их же фиг прослушать можно, в отличии от рации-то! Пошурши по ним, поищи, может там телеграммы с записью разговоров ещё остались - а я пока соображу награду для тебя за это дело."
	context = "Цель: Найти 2 Телефонные записи и принести Самопалу. Обычно они находятся в целых телефонных будках."
	goal = 2
	reward_money = 200
	reward_rep = 5

/datum/trader_quest/samopal_letter/can_complete(mob/living/carbon/human/H, obj/item/I)
	if(!istype(I, /obj/item/paper/fluff/eftk/telegraph))
		return FALSE
	qdel(I)
	progress++
	if(progress >= goal)
		return TRUE
	to_chat(H, span_notice("Передано записок: [progress]/[goal]."))
	return FALSE

/datum/trader_quest/samopal_bigots
	name = "В пасти зверя"
	id = "samopal_bigots"
	description = "О, а вот и ты, явился - не запылился! Ты-то мне как раз и нужен! Да погоди ты мне на мозоль давить по поводу телефонных записок, на хрен они нам сейчас не сдались! Обнулили моих бойцов на Орионе, представляешь? И ведь заразы такие решили сами на военку сунуться, без моего приказа! Ну и что ты думаешь? На куски их порвало, что-то неведомое, а вот что - шут его разберешь! Знаешь, до последнего не хотел тобой рисковать - но видимо, делать нам больше нечего. Придётся тебе самому с этой нечистью разобраться - у тебя в этом опыта поболее будет, всякую мразь к ногтю приставлять. Больше своих людей - я так подставлять не смогу. Вот, держи от меня рожок бронебоек к Калашу в довесок - они в миг этих тварей сами в фарш нашинкуют! Только смотри, держи ухо в остро и хвост - пистолетом, отряд у меня там большой был, все проверенные временем ребята - и те сгинули. Что-то там серьёзное поселилось - точно тебе говорю! Их там вроде двоих видели, поэтому можешь с напарником пойти, чтобы он тебе спину прикрыл - одного ты вразумишь, он - другого! Ну давай, ни пуха!"
	context = "Цель: Убить одного неизвестного мутанта в районе военной базы Орион-15. Задание можно потенциально выполнять с напарником."
	goal = 1
	reward_money = 500
	reward_rep = 10

/datum/trader_quest/samopal_bigots/start(mob/living/carbon/human/H)
	. = ..()
	var/obj/item/ammo_box/magazine/c762x39mm/ap/M = new
	if(H.put_in_hands(M))
		to_chat(H, span_notice("Самопал вручает вам магазин с бронебойными патронами."))
	else
		M.forceMove(get_turf(H))
		to_chat(H, span_notice("Самопал кладёт магазин с бронебойными патронами возле ваших ног."))

/datum/trader_quest/samopal_bigots/on_target_killed(mob/living/carbon/human/H, mob/living/victim)
	if(!istype(victim, /mob/living/basic/bigot))
		return FALSE
	if(!istype(get_area(victim), /area/new_sydney/military_base))
		return FALSE
	return TRUE

/datum/trader_quest/fashion_jacket
	name = "Потерянная куртка"
	id = "fashion_jacket"
	description = "Аллоха, братуха! Ещё один приблуда из мерков! Да ты не кипятись так - не кипяток же! Меня пока Фейшном зови, будем знакомы. Ты чего бледный такой, поганок объелся? Может тебе у милосердников Терезы проставиться? А, понял, ты пробудился только после отключки. Ну не беда, это даже без шота виски - дело поправимое. Пока работки серьёзной для тебя нет, браза, но меня тут одна маза гложит. Я когда сваливал в порт после ядерного пиздеца - пришлось по пути мой куртец скинуть, когда ящики грузил. Он мне дорог... ну, как память, понимаешь? Да чё ты ржёшь, ну со всеми же бывает! Так вот, кажись скинул его на северной автостраде на Побережье, которая в центр ведёт, рядом с одной из тачек. Только ты там давай поаккуратнее - там торчок этот отбитый ошивается, с битой в руках, походу тоже куртец мой вынюхивает. Так что давай, чоп-чоп. Буду ждать тебя с ним. А потом обрисую тебе дела поконкретнее."
	context = "Цель: Найти или сделать кожанную куртку Фейшна и передать ему. Она была потеряна на одной из северных дорог Побережья."
	reward_money = 250
	reward_rep = 5

/datum/trader_quest/fashion_jacket/can_complete(mob/living/carbon/human/H, obj/item/I)
	return istype(I, /obj/item/clothing/suit/jacket/leather_trenchcoat)

/datum/trader_quest/fashion_casino
	name = "Нюхач"
	id = "fashion_casino"
	description = "Ух, браза, вот благодарочка тебе конечно за то, что куртец мой вытянул. Поцарапали его конечно, сука, так, что он теперь совсем как из зашкварного загашника выглядит, но ничё. Ты же не думал, что я буду его сейчас в жару носить, как лох последний? В нём писулька одна была, от моего давнего кореша, но об чём она - пока не твоего ума дела, извини. Так, говоришь, хочешь с Прометеи свалить? Ну, билет на космоэлектричку тебе сейчас разве что наши доблестные федеративные власти смогут оформить… Хтьфу! До войны, шакалы сутулые не давали нормально марку держать - так теперь и вовсе решили нас закрыть тут на планете, как последних фраерков. Блокаду они орбитальную выкрутили в бараний рог, так что теперь на любом судне хрен свалишь - как мошкару прихлопнут из своих орудий. Но знаешь, есть у меня одна маза, которая может нас из этой сраки вытянуть, только мне опять твоя помощь понадобится. Ты видно что парень фартовый, к тому же не фраер - постоять за себя можешь. В моей темке как раз такие и нужны. Правда без обид - придется тебе немного как шнырь-курьёр сгонять кое-куда. Нужно, короче, разведать обстановочку в казике моего бывшего клана. Там в последнее время какие-то остолопы начали околачиваться, на зомбаков вроде не похожи. Если это те, о ком я думаю - ты с ними не закусывайся лучше, но если грохнешь этих мудаков - задавать вопросов не стану. Мне главное, чтобы ты в казике осмотрёл, чё почём."
	context = "Цель: Осмотреться некоторое время внутри казино “Night Gold” на Побережье и доложить Фейшну об обстановке."
	reward_money = 150
	reward_rep = 3
	var/inside_timer_started = FALSE
	var/completed_by_area = FALSE

/datum/trader_quest/fashion_casino/on_enter_area(mob/living/carbon/human/H, area/A)
	if(completed_by_area)
		return
	if(!istype(A, /area/new_sydney/building/night_gold_casino))
		return
	if(inside_timer_started)
		return
	inside_timer_started = TRUE
	to_chat(H, span_notice("Вы начинаете осматриваться. Нужно подождать здесь некоторое время..."))
	addtimer(CALLBACK(src, PROC_REF(finish_observation), H), 10 SECONDS)

/datum/trader_quest/fashion_casino/proc/finish_observation(mob/living/carbon/human/H)
	if(QDELETED(H))
		return
	if(!istype(get_area(H), /area/new_sydney/building/night_gold_casino))
		inside_timer_started = FALSE
		to_chat(H, span_warning("Вы покинули казино слишком рано."))
		return
	completed_by_area = TRUE
	complete(H, TRADER_FASHION, null)

/datum/trader_quest/fashion_armor
	name = "Добротный пошив"
	id = "fashion_armor"
	description = "О, салют, брателло. Ну что, позырил что там в казино? Почти всё вынесли, говоришь, даже документов старых не осталось? Бля, кажись подтверждаются мои самые отстойные опасения. Не буду тебе долго горбатого лепить, давай на прямки всё  обрисую. Короче, завелась у нас на Пустошах одна дамочка, которую иначе как шкурой - не назовёшь, но хотя бы погонялом не прикрывается, Камиллой зовут. Может слышал про семейку Ренотти - старые гангстеры, держали под собой весь ЭнЭс до всей этой движухи с бумом на станции. Камилла - как раз дорогая дочурка Ренотти-старшего, только она как только сиськи подросли - решила от папашки-то своего отколоться и свои дела мутить. Нашла себе хахаля из Синдиката - и тут понеслось. Сначала легкую наркоту сбывала контрабандой, потом перешла на стволы. Но незадолго до ядерного пиздеца - грохнули её паренька, чуть позже - уже отца. И она теперь воду баламутит и думает, что за этим я стою, представляешь? Я тебе так скажу, братишка - я вот нихрена не удивлюсь, если это её прихвостни вообще по заказу от Синдиката бомбу под станцию заложили. Ты же знаешь наверняка, как Синдикат работает - как отбитые на всю голову! А сейчас походу её архаровцы вышли за нами, чтобы хвосты подчистить. Вообщем, как говорил один дохуя мыслитель - хочешь мира - готовься к войне. Одну уже пережили и шкуры вроде целые - тут тоже нагнём лошков. Ты только мне подсоби, ладно? Броники нужно достать для моих пацанов, пару штук армейских, пятого класса защиты. А я тебя наградой не обижу."
	context = "Цель: Передать Фейшну 2 бронежилета морской пехоты."
	goal = 2
	reward_money = 450
	reward_rep = 6

/datum/trader_quest/fashion_armor/can_complete(mob/living/carbon/human/H, obj/item/I)
	if(!istype(I, /obj/item/clothing/suit/armor/vest/marine))
		return FALSE
	qdel(I)
	progress++
	if(progress >= goal)
		return TRUE
	to_chat(H, span_notice("Передано бронежилетов: [progress]/[goal]."))
	return FALSE

/datum/trader_quest/fashion_beacon
	name = "Накал страстей"
	id = "fashion_beacon"
	description = "Здарова, братка, ты-то мне как раз и нужен! Слушай, помнишь я тебе про Камиллу рассказывал? От души за броники, кстати, мои ребята уже на себя примеряют и довольные, как слоны. Но теперь нужно о моих торговых нычках позаботиться. Пока кипешь не начался - надо бы полки маяками обвесить, с датчиками слежения, чтобы если какая падаль сунется - сразу на наладонник сигнал подали. Только сразу тебе обрисую, чтобы ты на меня не гнал потом - нычки я в шахте Мистериус замутил, ну, которую НТшники забросили. Там просто надежнее всего хранить добро - мало кто в самое темное очко с тварями сунется. Ты сорян, конечно, что мне тебя приходится туда отправлять - но у тебя же работа такая - выбираться из всякого рода срак, хах! Поэтому маяки установи - и бегом кабанчиком оттуда, больше тебя ни о чём не прошу. А если тебе их не хватит - можешь у меня купить, цены как жлоб не заломлю, за базар отвечаю. Только пока дело не сделал - не суйся на Побережье. А то если тебя с маяками моими там спалят - накроется медной пиздой вся наша контора."
	context = "Цель: Заложить маяк на товарные полки в Шахте. Условие провала: Пойти в рейд на Побережье."
	goal = 1
	reward_money = 300
	reward_rep = 4

/datum/trader_quest/fashion_beacon/start(mob/living/carbon/human/H)
	. = ..()
	var/obj/item/beacon/M = new
	if(H.put_in_hands(M))
		to_chat(H, span_notice("Фейшн вручает вам отслеживающий маячок."))
	else
		M.forceMove(get_turf(H))
		to_chat(H, span_notice("Фейшн кладёт отслеживающий маячок у ваших ног."))

/datum/trader_quest/fashion_beacon/on_enter_area(mob/living/carbon/human/H, area/A)
	if(istype(A, /area/new_sydney/coast))
		fail(H, TRADER_FASHION, "Задание провалено. Вы нарушили указание Фейшна и пошли в рейд на Побережье до выполнения поручения. Репутация снижена на -3.")

/datum/trader_quest/fashion_targets
	name = "Внук Карвера"
	id = "fashion_targets"
	description = "Ну чё, кореш, понеслась тёпленькая по трубам. Мои ребята трубят о шухере на Побережье, там внезапно как черти повылезали бойцы Синдиката - ну, по прикиду, по крайней мере, похожи на них. Видать Камиллка охомутала твоих дружбанов-мерков на свою сторону, и теперь - они хотят по нам катком пройтись! Если ты всё ещё хочешь заиметь возможность свалить отсюда - придётся сначала отбиться от них, мужик, иначе они нам с тобой всю малину обосрут. Заодно поквитаемся со стервой за то, что решила всем голову посыпать ядерным пеплом. Может в разборках с этими недоносками выудим чё по пруфам касаемо того, что это они стоят за этим. Ты только не забудь в прикид моего клана одеться - во-первых, в таких шмотках не западло на любую разборку пойти, а во-вторых - пусть увидят, суки, что клан Павони - ещё может отстоять своё. И ты чё, думал, что я тебя на стрелку - с голыми руками отправлю? Держи вот - подарочек от моего клана, да ещё плюс бубен к нему. Он хоть буйвола, хоть бешеного мерка завалит - только целься точнее. Ну всё, погнал, верю в тебя."
	context = "Цель: Убить 5 Исполнителей, одетых в тактическую водолазку на локации Побережье, будучи одетым в гавайскую рубашку."
	goal = 5
	reward_money = 750
	reward_rep = 15

/datum/trader_quest/fashion_targets/start(mob/living/carbon/human/H)
