/// Exercise the real irradiation component: toxin immunity must not prevent its species callback.
/datum/unit_test/ipc_radiation_damage/Run()
	var/mob/living/carbon/human/ipc = allocate(/mob/living/carbon/human/consistent)
	ipc.set_species(/datum/species/ipc)
	var/obj/item/radiation_source = allocate(/obj/item, ipc.loc)
	var/datum/radiation_pulse_information/pulse = allocate(/datum/radiation_pulse_information)
	pulse.chance = 100
	pulse.threshold = 0
	pulse.turfs_to_process = list(get_turf(ipc))
	SSradiation.pulse(radiation_source, pulse)
	var/datum/component/irradiated/irradiation = ipc.GetComponent(/datum/component/irradiated)
	TEST_ASSERT_NOTNULL(irradiation, "An exposed IPC was not irradiated.")
	STOP_PROCESSING(SSobj, irradiation)
	var/initial_brain_damage = ipc.get_organ_loss(ORGAN_SLOT_BRAIN)
	TEST_ASSERT(initial_brain_damage > 0, "Irradiating a toxin-immune IPC did not damage its core.")
	TEST_ASSERT_EQUAL(ipc.get_tox_loss(), 0, "Synthetic irradiation added biological toxin damage.")
	irradiation.process(2)
	TEST_ASSERT(!QDELETED(irradiation), "Zero toxin damage immediately discarded IPC irradiation.")
	TEST_ASSERT_EQUAL(ipc.get_organ_loss(ORGAN_SLOT_BRAIN), initial_brain_damage + 1, "The IPC radiation callback did not apply its time-scaled brain damage.")
	var/initial_burn_damage = ipc.get_fire_loss()
	UNLINT(irradiation.give_burn_splotches())
	TEST_ASSERT(ipc.get_fire_loss() > initial_burn_damage, "Irradiation did not damage chassis electronics.")

/// Splitting elapsed time must preserve core damage; repairing the core ends the contamination effect.
/datum/unit_test/ipc_radiation_timing_and_repair/Run()
	var/mob/living/carbon/human/whole_tick = allocate(/mob/living/carbon/human/consistent)
	var/mob/living/carbon/human/split_tick = allocate(/mob/living/carbon/human/consistent)
	whole_tick.set_species(/datum/species/ipc)
	split_tick.set_species(/datum/species/ipc)
	var/datum/component/irradiated/whole_effect = whole_tick.AddComponent(/datum/component/irradiated)
	var/datum/component/irradiated/split_effect = split_tick.AddComponent(/datum/component/irradiated)
	STOP_PROCESSING(SSobj, whole_effect)
	STOP_PROCESSING(SSobj, split_effect)
	whole_effect.process(2)
	split_effect.process(1)
	split_effect.process(1)
	TEST_ASSERT_EQUAL(whole_tick.get_organ_loss(ORGAN_SLOT_BRAIN), split_tick.get_organ_loss(ORGAN_SLOT_BRAIN), "IPC radiation damage changed when a tick was split.")
	var/obj/item/organ/brain/ipc/core = whole_tick.get_organ_slot(ORGAN_SLOT_BRAIN)
	core.Remove(whole_tick)
	allocated += core
	TEST_ASSERT_NULL(whole_tick.get_organ_slot(ORGAN_SLOT_BRAIN), "The core extraction fixture left the brain installed.")
	whole_effect.process(1)
	TEST_ASSERT(!QDELETED(whole_effect), "Removing an unrepaired core cleared the chassis' irradiation.")
	TEST_ASSERT(HAS_TRAIT(whole_tick, TRAIT_IRRADIATED), "Core extraction removed the chassis' irradiation trait.")
	TEST_ASSERT(core.Insert(whole_tick), "The irradiated core could not be reinstalled.")
	whole_effect.process(1)
	TEST_ASSERT(!QDELETED(whole_effect), "Reinstalling an unrepaired core cleared irradiation.")
	TEST_ASSERT(whole_tick.get_organ_loss(ORGAN_SLOT_BRAIN) > 0, "Extracting and reinstalling an irradiated core repaired its damage.")
	whole_tick.set_organ_loss(ORGAN_SLOT_BRAIN, 0)
	whole_effect.process(1)
	TEST_ASSERT(QDELETED(whole_effect), "Repairing an IPC core left irradiation permanently active.")
	TEST_ASSERT(!HAS_TRAIT(whole_tick, TRAIT_IRRADIATED), "Core repair left the irradiation trait attached.")

/// Radiation protection and decontamination pauses use the same native gates as organic bodies.
/datum/unit_test/ipc_radiation_protection/Run()
	var/mob/living/carbon/human/ipc = allocate(/mob/living/carbon/human/consistent)
	ipc.set_species(/datum/species/ipc)
	var/obj/item/clothing/suit/utility/radiation/suit = allocate(/obj/item/clothing/suit/utility/radiation)
	var/obj/item/clothing/head/utility/radiation/hood = allocate(/obj/item/clothing/head/utility/radiation)
	ipc.equip_to_slot(suit, ITEM_SLOT_OCLOTHING)
	ipc.equip_to_slot(hood, ITEM_SLOT_HEAD)
	TEST_ASSERT(SSradiation.wearing_rad_protected_clothing(ipc), "The radiation suit fixture did not cover the IPC.")
	SSradiation.irradiate(ipc)
	TEST_ASSERT_NULL(ipc.GetComponent(/datum/component/irradiated), "A complete radiation suit failed to protect the IPC.")
	TEST_ASSERT_EQUAL(ipc.get_organ_loss(ORGAN_SLOT_BRAIN), 0, "Radiation bypassed a complete protective suit.")
	qdel(hood)
	SSradiation.irradiate(ipc)
	var/datum/component/irradiated/irradiation = ipc.GetComponent(/datum/component/irradiated)
	TEST_ASSERT_NOTNULL(irradiation, "Removing radiation head protection did not expose the IPC.")
	STOP_PROCESSING(SSobj, irradiation)
	var/initial_brain_damage = ipc.get_organ_loss(ORGAN_SLOT_BRAIN)
	SEND_SIGNAL(ipc, COMSIG_COMPONENT_CLEAN_ACT, CLEAN_TYPE_RADIATION)
	irradiation.process(2)
	TEST_ASSERT_EQUAL(ipc.get_organ_loss(ORGAN_SLOT_BRAIN), initial_brain_damage, "A radiation-cleaning pause did not stop IPC core damage.")
	irradiation.clean_cooldown = 0
	ADD_TRAIT(ipc, TRAIT_HALT_RADIATION_EFFECTS, TRAIT_SOURCE_UNIT_TESTS)
	irradiation.process(2)
	TEST_ASSERT_EQUAL(ipc.get_organ_loss(ORGAN_SLOT_BRAIN), initial_brain_damage, "Radiation-effect protection did not stop IPC core damage.")
	REMOVE_TRAIT(ipc, TRAIT_HALT_RADIATION_EFFECTS, TRAIT_SOURCE_UNIT_TESTS)
	ADD_TRAIT(ipc, TRAIT_RADIMMUNE, TRAIT_SOURCE_UNIT_TESTS)
	irradiation.process(1)
	TEST_ASSERT(QDELETED(irradiation), "Radiation immunity did not clear the IPC's irradiation component.")
	REMOVE_TRAIT(ipc, TRAIT_RADIMMUNE, TRAIT_SOURCE_UNIT_TESTS)

/// The synthetic path must not change organic toxin damage or its recovery condition.
/datum/unit_test/ipc_radiation_human_control/Run()
	var/mob/living/carbon/human/human = allocate(/mob/living/carbon/human/consistent)
	SSradiation.irradiate(human)
	var/datum/component/irradiated/irradiation = human.GetComponent(/datum/component/irradiated)
	TEST_ASSERT_NOTNULL(irradiation, "The ordinary human control could not be irradiated.")
	STOP_PROCESSING(SSobj, irradiation)
	TEST_ASSERT(human.get_tox_loss() > 0, "Irradiation no longer caused toxin damage to an organic human.")
	irradiation.process(1)
	TEST_ASSERT_EQUAL(human.get_organ_loss(ORGAN_SLOT_BRAIN), 0, "Synthetic radiation handling damaged an organic human's brain.")
	human.set_tox_loss(0)
	irradiation.process(1)
	TEST_ASSERT(QDELETED(irradiation), "Clearing organic toxin damage no longer ended irradiation.")

/// Nanopaste removes contamination, keeps accumulated damage, and supplies several finite doses.
/datum/unit_test/ipc_nanopaste_decontamination/Run()
	var/mob/living/carbon/human/ipc = allocate(/mob/living/carbon/human/consistent)
	ipc.set_species(/datum/species/ipc)
	var/mob/living/carbon/human/user = allocate(/mob/living/carbon/human/consistent/slow)
	user.add_or_update_variable_actionspeed_modifier(/datum/actionspeed_modifier/base, multiplicative_slowdown = 1)
	var/obj/item/stack/nanopaste/paste = allocate(/obj/item/stack/nanopaste)
	TEST_ASSERT(user.put_in_active_hand(paste), "Could not hold the nanopaste tube.")
	TEST_ASSERT_EQUAL(paste.get_amount(), 6, "A nanopaste tube did not contain six doses.")
	TEST_ASSERT_EQUAL(paste.max_amount, 6, "A nanopaste tube can exceed six doses.")
	var/datum/component/irradiated/irradiation = ipc.AddComponent(/datum/component/irradiated)
	STOP_PROCESSING(SSobj, irradiation)
	ipc.adjust_brute_loss(12)
	ipc.adjust_fire_loss(9)
	var/brain_damage = ipc.get_organ_loss(ORGAN_SLOT_BRAIN)
	var/brute_damage = ipc.get_brute_loss()
	var/burn_damage = ipc.get_fire_loss()
	TEST_ASSERT_EQUAL(paste.interact_with_atom(ipc, user, list()), ITEM_INTERACT_SUCCESS, "Nanopaste could not decontaminate an irradiated IPC.")
	TEST_ASSERT(QDELETED(irradiation), "Nanopaste left the irradiation component active.")
	TEST_ASSERT(!HAS_TRAIT(ipc, TRAIT_IRRADIATED), "Nanopaste left the irradiation trait attached.")
	TEST_ASSERT_EQUAL(paste.get_amount(), 5, "Decontamination did not consume exactly one dose.")
	TEST_ASSERT_EQUAL(ipc.get_organ_loss(ORGAN_SLOT_BRAIN), brain_damage, "Decontamination repaired the positronic brain.")
	TEST_ASSERT_EQUAL(ipc.get_brute_loss(), brute_damage, "Decontamination repaired chassis brute damage.")
	TEST_ASSERT_EQUAL(ipc.get_fire_loss(), burn_damage, "Decontamination repaired chassis burn damage.")
	TEST_ASSERT_EQUAL(paste.interact_with_atom(ipc, user, list()), ITEM_INTERACT_BLOCKING, "Nanopaste treated an already decontaminated IPC.")
	TEST_ASSERT_EQUAL(paste.get_amount(), 5, "An unnecessary treatment consumed another dose.")

	irradiation = ipc.AddComponent(/datum/component/irradiated)
	STOP_PROCESSING(SSobj, irradiation)
	TEST_ASSERT_EQUAL(paste.interact_with_atom(ipc, user, list()), ITEM_INTERACT_SUCCESS, "The same tube could not supply a second treatment.")
	TEST_ASSERT_EQUAL(paste.get_amount(), 4, "A second treatment consumed the wrong number of doses.")
	TEST_ASSERT(paste.use(3, check = FALSE), "Could not prepare a final-dose tube.")
	user.set_species(/datum/species/ipc)
	irradiation = user.AddComponent(/datum/component/irradiated)
	STOP_PROCESSING(SSobj, irradiation)
	TEST_ASSERT_EQUAL(paste.interact_with_atom(user, user, list()), ITEM_INTERACT_SUCCESS, "An IPC could not apply its final nanopaste dose to itself.")
	TEST_ASSERT(QDELETED(irradiation), "Self-treatment left the IPC irradiated.")
	TEST_ASSERT(QDELETED(paste), "A fully consumed nanopaste tube was not deleted.")

/// Healthy IPCs, organic patients and empty tubes must not consume or remove anything.
/datum/unit_test/ipc_nanopaste_rejection/Run()
	var/mob/living/carbon/human/user = allocate(/mob/living/carbon/human/consistent)
	var/mob/living/carbon/human/organic = allocate(/mob/living/carbon/human/consistent)
	var/mob/living/carbon/human/ipc = allocate(/mob/living/carbon/human/consistent)
	ipc.set_species(/datum/species/ipc)
	var/obj/item/stack/nanopaste/paste = allocate(/obj/item/stack/nanopaste)
	TEST_ASSERT(user.put_in_active_hand(paste), "Could not hold the rejection test's nanopaste.")
	var/datum/component/irradiated/organic_irradiation = organic.AddComponent(/datum/component/irradiated)
	STOP_PROCESSING(SSobj, organic_irradiation)
	TEST_ASSERT_EQUAL(paste.interact_with_atom(organic, user, list()), ITEM_INTERACT_BLOCKING, "Nanopaste accepted an irradiated organic patient.")
	TEST_ASSERT(!QDELETED(organic_irradiation), "Nanopaste decontaminated an organic patient.")
	TEST_ASSERT_EQUAL(paste.interact_with_atom(ipc, user, list()), ITEM_INTERACT_BLOCKING, "Nanopaste accepted an uncontaminated IPC.")
	TEST_ASSERT_EQUAL(paste.get_amount(), 6, "Rejected targets consumed nanopaste.")
	TEST_ASSERT(paste.use(6, check = FALSE), "Could not empty the nanopaste tube without deleting it.")
	var/datum/component/irradiated/ipc_irradiation = ipc.AddComponent(/datum/component/irradiated)
	STOP_PROCESSING(SSobj, ipc_irradiation)
	TEST_ASSERT_EQUAL(paste.interact_with_atom(ipc, user, list()), ITEM_INTERACT_BLOCKING, "An empty tube reported a successful treatment.")
	TEST_ASSERT(!QDELETED(ipc_irradiation), "An empty tube removed IPC irradiation.")

/// A real treatment delay must recheck the held tube, patient, contamination and available dose.
/datum/unit_test/ipc_nanopaste_interrupted/Run()
	var/mob/living/carbon/human/ipc = allocate(/mob/living/carbon/human/consistent)
	ipc.set_species(/datum/species/ipc)
	var/mob/living/carbon/human/user = allocate(/mob/living/carbon/human/consistent/slow)
	user.add_or_update_variable_actionspeed_modifier(/datum/actionspeed_modifier/base, multiplicative_slowdown = 1)
	var/obj/item/stack/nanopaste/paste = allocate(/obj/item/stack/nanopaste)
	TEST_ASSERT(user.put_in_active_hand(paste), "Could not hold the interruption test's nanopaste.")
	var/datum/component/irradiated/irradiation = ipc.AddComponent(/datum/component/irradiated)
	STOP_PROCESSING(SSobj, irradiation)
	addtimer(CALLBACK(user, TYPE_PROC_REF(/mob, dropItemToGround), paste), 1)
	TEST_ASSERT_EQUAL(paste.interact_with_atom(ipc, user, list()), ITEM_INTERACT_BLOCKING, "Dropping the tube did not interrupt treatment.")
	TEST_ASSERT(!QDELETED(irradiation), "Interrupted treatment removed irradiation.")
	TEST_ASSERT_EQUAL(paste.get_amount(), 6, "Interrupted treatment consumed nanopaste.")
	TEST_ASSERT(!DOING_INTERACTION_WITH_TARGET(user, ipc), "Interrupted treatment left an interaction active.")

	TEST_ASSERT(user.put_in_active_hand(paste), "Could not pick up the interrupted treatment's tube.")
	QDEL_IN(irradiation, 1)
	TEST_ASSERT_EQUAL(paste.interact_with_atom(ipc, user, list()), ITEM_INTERACT_BLOCKING, "Treatment succeeded after another source removed irradiation.")
	TEST_ASSERT_EQUAL(paste.get_amount(), 6, "A redundant concurrent treatment consumed nanopaste.")
	irradiation = ipc.AddComponent(/datum/component/irradiated)
	STOP_PROCESSING(SSobj, irradiation)
	addtimer(CALLBACK(ipc, TYPE_PROC_REF(/mob, set_species), /datum/species/human), 1)
	TEST_ASSERT_EQUAL(paste.interact_with_atom(ipc, user, list()), ITEM_INTERACT_BLOCKING, "Treatment succeeded after the patient stopped being an IPC.")
	TEST_ASSERT(is_species(ipc, /datum/species/human), "The test did not change the patient's species during treatment.")
	TEST_ASSERT_EQUAL(paste.get_amount(), 6, "Treatment consumed nanopaste after a species change.")
	ipc.set_species(/datum/species/ipc)
	irradiation = ipc.GetComponent(/datum/component/irradiated)
	TEST_ASSERT_NOTNULL(irradiation, "The interruption fixture unexpectedly lost its irradiation component.")
	addtimer(CALLBACK(paste, TYPE_PROC_REF(/obj/item/stack, use), 6, FALSE, FALSE), 1)
	TEST_ASSERT_EQUAL(paste.interact_with_atom(ipc, user, list()), ITEM_INTERACT_BLOCKING, "Treatment succeeded after its tube was emptied during the delay.")
	TEST_ASSERT(!QDELETED(irradiation), "Treatment without a remaining dose removed irradiation.")
	TEST_ASSERT(QDELETED(paste) || !paste.get_amount(), "The interrupted tube's emptying fixture did not run.")
