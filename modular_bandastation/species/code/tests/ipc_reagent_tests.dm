/// Reject chemicals at the holder boundary, including low-purity conversions and transfers which copy their source.
/datum/unit_test/ipc_reagent_ingress/Run()
	var/mob/living/carbon/human/ipc = allocate(/mob/living/carbon/human/consistent)
	ipc.set_species(/datum/species/ipc)
	TEST_ASSERT_EQUAL(ipc.reagents.add_reagent(/datum/reagent/medicine/stimulants, 10), 0, "An IPC accepted a directly added stimulant.")
	TEST_ASSERT_EQUAL(ipc.reagents.add_reagent(/datum/reagent/toxin/chloralhydrate, 10, added_purity = 0.01), 0, "An IPC accepted a low-purity sedative or its inverse reagent.")
	ipc.reagents.add_reagent_list(list(/datum/reagent/medicine/stimulants = 10, /datum/reagent/toxin/chloralhydrate = 10))
	TEST_ASSERT_EQUAL(ipc.reagents.total_volume, 0, "Adding a reagent list bypassed IPC chemical rejection.")
	TEST_ASSERT_EQUAL(length(ipc.reagents.reagent_list), 0, "Rejected additions left reagent datums in the IPC holder.")

	var/obj/item/reagent_containers/cup/beaker/source = allocate(/obj/item/reagent_containers/cup/beaker)
	source.reagents.add_reagent_list(list(/datum/reagent/medicine/stimulants = 10, /datum/reagent/toxin/chloralhydrate = 10))
	TEST_ASSERT(!source.reagents.trans_to(ipc, 5), "A direct transfer into an IPC reported success.")
	TEST_ASSERT(!source.reagents.trans_to(ipc.reagents, 5), "Targeting the IPC holder directly bypassed chemical rejection.")
	TEST_ASSERT(!source.reagents.trans_to(ipc, 5, copy_only = TRUE), "A copying transfer into an IPC reported success.")
	TEST_ASSERT_EQUAL(ipc.reagents.total_volume, 0, "A transfer left chemicals in the IPC body.")
	TEST_ASSERT_EQUAL(source.reagents.total_volume, 20, "Rejected IPC transfers consumed their source chemicals.")

	var/mob/living/carbon/human/organic = allocate(/mob/living/carbon/human/consistent)
	TEST_ASSERT_EQUAL(source.reagents.trans_to(organic, 5, copy_only = TRUE), 5, "An organic control could not receive copied chemicals.")
	TEST_ASSERT_EQUAL(source.reagents.total_volume, 20, "A copying transfer consumed the source chemicals.")
	TEST_ASSERT_EQUAL(source.reagents.trans_to(organic.reagents, 5), 5, "An organic control could not receive a direct holder transfer.")
	TEST_ASSERT_EQUAL(organic.reagents.total_volume, 10, "The organic control received an incorrect chemical dose.")
	TEST_ASSERT_EQUAL(source.reagents.total_volume, 15, "An accepted organic transfer consumed an incorrect amount.")

	// Reaction agents modify existing contents before add_reagent(); legacy contents must not reopen that route.
	REMOVE_TRAIT(ipc, TRAIT_REAGENT_IMMUNE, SPECIES_TRAIT)
	ipc.reagents.add_reagent(/datum/reagent/water, 10, no_react = TRUE)
	ADD_TRAIT(ipc, TRAIT_REAGENT_IMMUNE, SPECIES_TRAIT)
	var/legacy_ph = ipc.reagents.ph
	var/obj/item/reagent_containers/cup/beaker/buffer = allocate(/obj/item/reagent_containers/cup/beaker)
	buffer.reagents.add_reagent(/datum/reagent/reaction_agent/acidic_buffer, 10)
	TEST_ASSERT(!buffer.reagents.trans_to(ipc, 5), "A reaction agent transferred into an immune body with legacy contents.")
	TEST_ASSERT_EQUAL(ipc.reagents.ph, legacy_ph, "A rejected reaction agent modified the IPC's legacy contents before addition was blocked.")
	TEST_ASSERT_EQUAL(buffer.reagents.total_volume, 10, "A rejected reaction agent consumed its source before addition was blocked.")

/// Exercise the actual injector entry points, including the hypospray path which exposes before copying.
/datum/unit_test/ipc_reagent_injectors/Run()
	var/mob/living/carbon/human/ipc = allocate(/mob/living/carbon/human/consistent)
	ipc.set_species(/datum/species/ipc)
	var/mob/living/carbon/human/organic = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/reagent_containers/syringe/syringe = allocate(/obj/item/reagent_containers/syringe)
	syringe.reagents.add_reagent_list(list(/datum/reagent/medicine/stimulants = 10, /datum/reagent/toxin/chloralhydrate = 5))
	TEST_ASSERT_EQUAL(syringe.interact_with_atom(ipc, ipc, list()), ITEM_INTERACT_BLOCKING, "A syringe reported a successful IPC injection.")
	TEST_ASSERT_EQUAL(ipc.reagents.total_volume, 0, "A real syringe injected chemicals into an IPC.")
	TEST_ASSERT_EQUAL(syringe.reagents.total_volume, 15, "A rejected IPC injection consumed the syringe contents.")
	TEST_ASSERT_EQUAL(syringe.interact_with_atom(organic, organic, list()), ITEM_INTERACT_SUCCESS, "The syringe could not inject an organic control.")
	TEST_ASSERT_EQUAL(organic.reagents.total_volume, syringe.amount_per_transfer_from_this, "The syringe gave the organic control an incorrect dose.")
	TEST_ASSERT_EQUAL(syringe.reagents.total_volume, 15 - syringe.amount_per_transfer_from_this, "The accepted syringe injection consumed an incorrect amount.")

	var/obj/item/reagent_containers/hypospray/ordinary = allocate(/obj/item/reagent_containers/hypospray)
	var/obj/item/reagent_containers/hypospray/combat/empty/combat = allocate(/obj/item/reagent_containers/hypospray/combat/empty)
	var/obj/item/reagent_containers/hypospray/combat/empty/infinite = allocate(/obj/item/reagent_containers/hypospray/combat/empty)
	infinite.infinite = TRUE
	for(var/obj/item/reagent_containers/hypospray/injector as anything in list(ordinary, combat, infinite))
		injector.reagents.add_reagent_list(list(/datum/reagent/medicine/stimulants = 10, /datum/reagent/toxin/chloralhydrate = 10))
		injector.inject(ipc, ipc)
		TEST_ASSERT_EQUAL(ipc.reagents.total_volume, 0, "[injector.type] injected chemicals into an IPC.")
		TEST_ASSERT_EQUAL(injector.reagents.total_volume, 20, "[injector.type] consumed chemicals during a rejected IPC injection.")
		organic.reagents.clear_reagents()
		TEST_ASSERT(injector.inject(organic, organic), "[injector.type] could not inject an organic control.")
		TEST_ASSERT_EQUAL(organic.reagents.total_volume, injector.amount_per_transfer_from_this, "[injector.type] gave the organic control an incorrect dose.")
		TEST_ASSERT_EQUAL(injector.reagents.total_volume, 20 - (injector.infinite ? 0 : injector.amount_per_transfer_from_this), "[injector.type] consumed an incorrect amount during an organic injection.")

/// Replacing the body holder or installing a filled stomach must not reopen a chemical route.
/datum/unit_test/ipc_reagent_organ_holder/Run()
	var/mob/living/carbon/human/ipc = allocate(/mob/living/carbon/human/consistent)
	ipc.set_species(/datum/species/ipc)
	ipc.create_reagents(1000, REAGENT_HOLDER_ALIVE)
	TEST_ASSERT_EQUAL(ipc.reagents.add_reagent(/datum/reagent/medicine/stimulants, 10), 0, "Replacing the IPC body holder removed chemical rejection.")
	var/obj/item/reagent_containers/cup/beaker/source = allocate(/obj/item/reagent_containers/cup/beaker)
	source.forceMove(ipc)
	TEST_ASSERT_EQUAL(source.reagents.add_reagent(/datum/reagent/medicine/stimulants, 20), 20, "An ordinary beaker carried by an IPC could not store chemicals.")
	TEST_ASSERT(!source.reagents.trans_to(ipc, 5, methods = INJECT), "A recreated IPC holder accepted an injection.")
	TEST_ASSERT_EQUAL(ipc.reagents.total_volume, 0, "A recreated IPC holder retained injected chemicals.")

	var/obj/item/organ/stomach/stomach = allocate(/obj/item/organ/stomach)
	stomach.reagents.clear_reagents()
	TEST_ASSERT_EQUAL(stomach.reagents.add_reagent(/datum/reagent/toxin/chloralhydrate, 10), 10, "The detached stomach fixture could not hold chemicals.")
	TEST_ASSERT(stomach.Insert(ipc, special = TRUE, movement_flags = DELETE_IF_REPLACED), "The stomach fixture could not be installed in an IPC.")
	TEST_ASSERT_EQUAL(stomach.reagents.total_volume, 0, "Transplanting a filled stomach smuggled chemicals into an IPC.")
	TEST_ASSERT_EQUAL(stomach.reagents.add_reagent(/datum/reagent/medicine/stimulants, 5), 0, "An installed IPC stomach accepted directly added chemicals.")
	TEST_ASSERT(!source.reagents.trans_to(stomach.reagents, 5), "A direct holder transfer bypassed the installed stomach's rejection.")
	TEST_ASSERT(!source.reagents.trans_to(ipc, 5, methods = INGEST), "The INGEST route bypassed chemical rejection through a transplanted stomach.")
	TEST_ASSERT_EQUAL(stomach.reagents.total_volume, 0, "A transplanted IPC stomach retained chemicals.")
	TEST_ASSERT_EQUAL(source.reagents.total_volume, 20, "Rejected body or stomach transfers consumed the carried beaker's contents.")

	stomach.Remove(ipc, special = TRUE)
	var/mob/living/carbon/human/organic = allocate(/mob/living/carbon/human/consistent)
	TEST_ASSERT(stomach.Insert(organic, special = TRUE, movement_flags = DELETE_IF_REPLACED), "The removed stomach could not be transplanted into an organic control.")
	TEST_ASSERT_EQUAL(source.reagents.trans_to(organic, 5, methods = INGEST), 5, "A former IPC stomach still rejected chemicals in an organic owner.")
	TEST_ASSERT_EQUAL(stomach.reagents.total_volume, 5, "The organic control's transplanted stomach received an incorrect chemical dose.")
	TEST_ASSERT_EQUAL(source.reagents.total_volume, 15, "The accepted INGEST transfer consumed an incorrect amount.")
