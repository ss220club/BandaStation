/// The food widget must never represent stored charge, including after HUD recreation or species changes.
/datum/unit_test/ipc_hunger_hud/Run()
	var/mob/living/carbon/human/human = allocate(/mob/living/carbon/human/consistent)
	var/datum/hud/human/human_hud = new(human)
	human.set_hud_used(human_hud)
	TEST_ASSERT_NOTNULL(human_hud.screen_objects[HUD_MOB_HUNGER], "An organic human started without its hunger widget.")
	human.set_nutrition(125, forced = TRUE)
	human.set_species(/datum/species/ipc)
	TEST_ASSERT_NULL(human_hud.screen_objects[HUD_MOB_HUNGER], "Transforming into an IPC retained a hunger widget.")
	TEST_ASSERT_EQUAL(human.nutrition, 125, "Removing the hunger HUD changed the IPC's stored charge.")
	human.update_nutrition()
	TEST_ASSERT_NULL(human_hud.screen_objects[HUD_MOB_HUNGER], "A charge update restored the IPC's hunger widget.")
	human.set_species(/datum/species/human)
	TEST_ASSERT_NOTNULL(human_hud.screen_objects[HUD_MOB_HUNGER], "Transforming back to a human failed to restore hunger.")
	human.set_species(/datum/species/ipc)
	TEST_ASSERT_NULL(human_hud.screen_objects[HUD_MOB_HUNGER], "A second IPC transformation retained hunger.")

	var/mob/living/carbon/human/new_ipc = allocate(/mob/living/carbon/human/consistent)
	new_ipc.set_species(/datum/species/ipc)
	var/datum/hud/human/ipc_hud = new(new_ipc)
	new_ipc.set_hud_used(ipc_hud)
	TEST_ASSERT_NULL(ipc_hud.screen_objects[HUD_MOB_HUNGER], "An IPC's newly created HUD included a hunger widget.")
	TEST_ASSERT_NOTNULL(ipc_hud.screen_objects[HUD_MOB_HEALTHDOLL], "Removing hunger also removed the IPC health doll.")
