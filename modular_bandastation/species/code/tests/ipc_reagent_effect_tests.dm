/// Chemical exposure must stop before callbacks can apply damage or temporary symptoms.
/datum/unit_test/ipc_reagent_exposure_immunity/Run()
	var/mob/living/carbon/human/ipc = allocate(/mob/living/carbon/human/consistent)
	ipc.set_species(/datum/species/ipc)
	var/mob/living/carbon/human/organic = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/reagent_containers/cup/beaker/source = allocate(/obj/item/reagent_containers/cup/beaker)
	for(var/reagent_type in list(/datum/reagent/toxin/acid, /datum/reagent/consumable/condensedcapsaicin, /datum/reagent/medicine/stimulants, /datum/reagent/toxin/chloralhydrate))
		source.reagents.add_reagent(reagent_type, 10, no_react = TRUE)
	for(var/method in list(TOUCH, VAPOR, INHALE, INGEST, INJECT, PATCH, SMOKE_MACHINE))
		source.reagents.expose(ipc, method)
		TEST_ASSERT_EQUAL(ipc.reagents.total_volume, 0, "Chemical exposure method [method] deposited reagents in an IPC.")
		TEST_ASSERT_EQUAL(ipc.get_brute_loss(), 0, "Chemical exposure method [method] damaged an IPC.")
		TEST_ASSERT_EQUAL(ipc.get_fire_loss(), 0, "Chemical exposure method [method] burned an IPC.")
		TEST_ASSERT(!ipc.IsKnockdown(), "Chemical exposure method [method] knocked an IPC down.")
		TEST_ASSERT(!ipc.IsSleeping(), "Chemical exposure method [method] put an IPC to sleep.")
		TEST_ASSERT(!HAS_TRAIT(ipc, TRAIT_ANOSMIA), "Chemical exposure method [method] gave an IPC anosmia.")
		TEST_ASSERT(!HAS_TRAIT(ipc, TRAIT_STIMULATED), "Chemical exposure method [method] stimulated an IPC.")
		TEST_ASSERT(!ipc.has_movespeed_modifier(/datum/movespeed_modifier/reagent/pepperspray), "Chemical exposure method [method] slowed an IPC with pepper spray.")

	source.reagents.expose(organic, TOUCH)
	TEST_ASSERT(organic.IsKnockdown(), "The organic control did not react to pepper spray exposure.")
	TEST_ASSERT(HAS_TRAIT(organic, TRAIT_ANOSMIA), "The organic control did not receive the pepper spray symptom.")
	source.reagents.expose(organic, INJECT)
	TEST_ASSERT(organic.get_brute_loss() > 0, "The organic control was not damaged by acid exposure.")

/// Exercise the actual foam and chemical smoke entry points without spreading either around the test room.
/datum/unit_test/ipc_reagent_foam_and_smoke/Run()
	var/mob/living/carbon/human/ipc = allocate(/mob/living/carbon/human/consistent)
	ipc.set_species(/datum/species/ipc)
	var/mob/living/carbon/human/organic = allocate(/mob/living/carbon/human/consistent)
	var/obj/effect/particle_effect/fluid/foam/foam = allocate(/obj/effect/particle_effect/fluid/foam)
	allocated += foam.group
	foam.reagents.add_reagent(/datum/reagent/consumable/condensedcapsaicin, 10)
	foam.foam_mob(ipc, SSMOBS_DT)
	TEST_ASSERT(!ipc.IsKnockdown(), "Reagent foam applied pepper spray's immediate effect to an IPC.")
	TEST_ASSERT(!HAS_TRAIT(ipc, TRAIT_ANOSMIA), "Reagent foam gave an IPC anosmia.")
	foam.foam_mob(organic, SSMOBS_DT)
	TEST_ASSERT(organic.IsKnockdown(), "The organic control did not react to reagent foam.")

	var/obj/effect/particle_effect/fluid/smoke/chem/smoke = allocate(/obj/effect/particle_effect/fluid/smoke/chem)
	allocated += smoke.group
	smoke.reagents.add_reagent(/datum/reagent/medicine/stimulants, 10)
	smoke.smoke_mob(ipc, SSMOBS_DT)
	TEST_ASSERT_EQUAL(ipc.reagents.total_volume, 0, "Chemical smoke deposited reagents in an IPC.")
	smoke.smoke_mob(organic, SSMOBS_DT)
	TEST_ASSERT(organic.reagents.has_reagent(/datum/reagent/medicine/stimulants), "The organic control did not absorb chemical smoke.")

/// Conversion must remove existing chemicals and their active modifiers, while preserving unrelated sleep.
/datum/unit_test/ipc_reagent_species_change_cleanup/Run()
	var/mob/living/carbon/human/human = allocate(/mob/living/carbon/human/consistent)
	human.reagents.add_reagent(/datum/reagent/medicine/stimulants, 10)
	human.reagents.metabolize(human, SSMOBS_DT)
	TEST_ASSERT(HAS_TRAIT(human, TRAIT_STIMULATED), "The human control did not metabolize stimulants.")
	TEST_ASSERT(human.has_movespeed_modifier(/datum/movespeed_modifier/reagent/stimulants), "The human control did not receive the stimulant speed modifier.")
	human.Sleeping(30 SECONDS)
	TEST_ASSERT(human.IsSleeping(), "The unrelated sleep fixture did not put the human to sleep.")
	var/original_sleep = human.AmountSleeping()

	human.set_species(/datum/species/ipc)
	TEST_ASSERT_EQUAL(human.reagents.total_volume, 0, "Conversion into an IPC retained existing chemicals.")
	TEST_ASSERT(!HAS_TRAIT(human, TRAIT_STIMULATED), "Conversion into an IPC retained an active stimulant trait.")
	TEST_ASSERT(!human.has_movespeed_modifier(/datum/movespeed_modifier/reagent/stimulants), "Conversion into an IPC retained the stimulant speed modifier.")
	TEST_ASSERT_EQUAL(human.AmountSleeping(), original_sleep, "Chemical cleanup erased sleep from an unrelated source.")

	human.set_species(/datum/species/human)
	TEST_ASSERT(!HAS_TRAIT(human, TRAIT_REAGENT_IMMUNE), "IPC chemical immunity survived conversion into a human.")
	human.reagents.add_reagent(/datum/reagent/medicine/stimulants, 10)
	human.reagents.metabolize(human, SSMOBS_DT)
	TEST_ASSERT(HAS_TRAIT(human, TRAIT_STIMULATED), "Stimulants stopped working after conversion back into a human.")
	TEST_ASSERT(human.has_movespeed_modifier(/datum/movespeed_modifier/reagent/stimulants), "The restored human did not receive the stimulant speed modifier.")

/// Legacy saved chemicals must be purged even through direct metabolism and the separate stasis path.
/datum/unit_test/ipc_reagent_legacy_metabolism/Run()
	var/mob/living/carbon/human/ipc = allocate(/mob/living/carbon/human/consistent)
	ipc.set_species(/datum/species/ipc)
	// Seed an old body's chemical state before restoring the new immunity.
	REMOVE_TRAIT(ipc, TRAIT_REAGENT_IMMUNE, SPECIES_TRAIT)
	ipc.reagents.add_reagent(/datum/reagent/medicine/stimulants, 10)
	ipc.reagents.metabolize(ipc, SSMOBS_DT)
	TEST_ASSERT(HAS_TRAIT(ipc, TRAIT_STIMULATED), "The legacy fixture did not activate its stimulant.")
	ADD_TRAIT(ipc, TRAIT_REAGENT_IMMUNE, SPECIES_TRAIT)
	ADD_TRAIT(ipc, TRAIT_STASIS, TRAIT_SOURCE_UNIT_TESTS)
	ipc.Sleeping(30 SECONDS)
	TEST_ASSERT(ipc.IsSleeping(), "The unrelated sleep fixture did not put the IPC to sleep.")
	var/original_sleep = ipc.AmountSleeping()
	ipc.reagents.handle_stasis_chems(ipc, SSMOBS_DT)
	TEST_ASSERT_EQUAL(ipc.reagents.total_volume, 0, "Stasis retained legacy IPC chemicals.")
	TEST_ASSERT(!HAS_TRAIT(ipc, TRAIT_STIMULATED), "Stasis retained the legacy stimulant trait.")
	TEST_ASSERT(!ipc.has_movespeed_modifier(/datum/movespeed_modifier/reagent/stimulants), "Stasis retained the legacy stimulant speed modifier.")
	TEST_ASSERT(HAS_TRAIT(ipc, TRAIT_STASIS), "Chemical cleanup removed stasis.")
	TEST_ASSERT_EQUAL(ipc.AmountSleeping(), original_sleep, "Legacy cleanup erased unrelated sleep.")

	REMOVE_TRAIT(ipc, TRAIT_REAGENT_IMMUNE, SPECIES_TRAIT)
	ipc.reagents.add_reagent(/datum/reagent/medicine/stimulants, 10)
	var/datum/reagent/stimulant = ipc.reagents.has_reagent(/datum/reagent/medicine/stimulants)
	ADD_TRAIT(ipc, TRAIT_REAGENT_IMMUNE, SPECIES_TRAIT)
	ipc.reagents.metabolize_reagent(ipc, stimulant, SSMOBS_DT)
	TEST_ASSERT_EQUAL(ipc.reagents.total_volume, 0, "Direct metabolism retained a legacy IPC chemical.")
	TEST_ASSERT(!HAS_TRAIT(ipc, TRAIT_STIMULATED), "Direct metabolism activated a stimulant before checking IPC immunity.")
	TEST_ASSERT(!ipc.has_movespeed_modifier(/datum/movespeed_modifier/reagent/stimulants), "Direct metabolism activated a stimulant speed modifier before checking IPC immunity.")

/// Blob strains call chemical callbacks directly, outside ordinary batch exposure.
/datum/unit_test/ipc_blob_reagent_immunity/Run()
	var/mob/living/carbon/human/ipc = allocate(/mob/living/carbon/human/consistent)
	ipc.set_species(/datum/species/ipc)
	var/mob/living/carbon/human/organic = allocate(/mob/living/carbon/human/consistent)
	var/datum/blobstrain/reagent/cryogenic_poison/poison = allocate(/datum/blobstrain/reagent/cryogenic_poison)
	allocated += poison.reagent
	poison.attack_living(ipc)
	poison.blobbernaut_attack(null, ipc)
	TEST_ASSERT_EQUAL(ipc.reagents.total_volume, 0, "A blob chemical attack deposited reagents in an IPC.")
	TEST_ASSERT_EQUAL(ipc.get_brute_loss(), 0, "A blob chemical callback damaged an IPC.")
	poison.attack_living(organic)
	TEST_ASSERT(organic.reagents.total_volume > 0, "The organic control did not receive the blob's freezing poison.")
	TEST_ASSERT(organic.get_brute_loss() > 0, "The organic control was not damaged by the blob chemical callback.")

	var/datum/blobstrain/reagent/blazing_oil/oil = allocate(/datum/blobstrain/reagent/blazing_oil)
	allocated += oil.reagent
	oil.attack_living(ipc)
	oil.blobbernaut_attack(null, ipc)
	TEST_ASSERT_EQUAL(ipc.fire_stacks, 0, "Blazing oil applied chemical fire stacks to an IPC.")
	TEST_ASSERT(!ipc.on_fire, "Blazing oil ignited an IPC through a direct chemical callback.")
	TEST_ASSERT_EQUAL(ipc.get_fire_loss(), 0, "Blazing oil's chemical callback burned an IPC.")
	ipc.apply_damage(10, BRUTE, wound_bonus = CANT_WOUND)
	TEST_ASSERT(ipc.get_brute_loss() > 0, "Chemical immunity also prevented ordinary physical damage.")
