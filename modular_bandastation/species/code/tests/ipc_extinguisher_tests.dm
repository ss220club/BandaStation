/// Actual extinguisher contents must put an IPC out when their spray particle hits it.
/datum/unit_test/ipc_extinguisher_spray/Run()
	var/mob/living/carbon/human/ipc = allocate(/mob/living/carbon/human/consistent)
	ipc.set_species(/datum/species/ipc)
	var/mob/living/carbon/human/organic = allocate(/mob/living/carbon/human/consistent)
	for(var/extinguisher_type in list(/obj/item/extinguisher, /obj/item/extinguisher/mini, /obj/item/extinguisher/advanced))
		var/obj/item/extinguisher/extinguisher = allocate(extinguisher_type)
		var/obj/effect/particle_effect/water/extinguisher/particle = allocate(/obj/effect/particle_effect/water/extinguisher)
		particle.create_reagents(5)
		TEST_ASSERT_EQUAL(extinguisher.reagents.trans_to(particle, 1), 1, "[extinguisher_type] could not load its spray particle.")
		ipc.set_fire_stacks(5)
		TEST_ASSERT(ipc.ignite_mob(silent = TRUE), "The IPC fixture did not catch fire.")
		particle.Bump(ipc)
		TEST_ASSERT(!ipc.on_fire, "[extinguisher_type]'s spray could not extinguish an IPC.")
		TEST_ASSERT_EQUAL(ipc.fire_stacks, 0, "[extinguisher_type]'s spray left fire stacks on an IPC.")
		TEST_ASSERT_EQUAL(ipc.reagents.total_volume, 0, "[extinguisher_type]'s spray introduced reagents into an IPC.")

		organic.set_fire_stacks(5)
		TEST_ASSERT(organic.ignite_mob(silent = TRUE), "The organic control did not catch fire.")
		particle.Bump(organic)
		TEST_ASSERT(!organic.on_fire, "[extinguisher_type]'s spray stopped extinguishing organic mobs.")
		TEST_ASSERT(organic.fire_stacks <= 0, "The organic control retained positive fire stacks after extinguishing.")

/// Allowing physical fire suppression must not enable the rest of a contaminated spray's chemistry.
/datum/unit_test/ipc_extinguisher_mixed_chemicals/Run()
	var/mob/living/carbon/human/ipc = allocate(/mob/living/carbon/human/consistent)
	ipc.set_species(/datum/species/ipc)
	var/obj/item/reagent_containers/cup/beaker/source = allocate(/obj/item/reagent_containers/cup/beaker)
	for(var/reagent_type in list(/datum/reagent/water, /datum/reagent/consumable/condensedcapsaicin, /datum/reagent/medicine/stimulants, /datum/reagent/toxin/chloralhydrate))
		source.reagents.add_reagent(reagent_type, 10, no_react = TRUE)
	ipc.set_fire_stacks(5)
	TEST_ASSERT(ipc.ignite_mob(silent = TRUE), "The contaminated spray fixture did not catch fire.")
	ipc.Sleeping(30 SECONDS)
	TEST_ASSERT(ipc.IsSleeping(), "The unrelated sleep fixture did not put the IPC to sleep.")
	var/original_sleep = ipc.AmountSleeping()
	source.reagents.expose(ipc, TOUCH)
	TEST_ASSERT(!ipc.on_fire, "Water in a contaminated spray did not extinguish an IPC.")
	TEST_ASSERT_EQUAL(ipc.fire_stacks, 0, "A contaminated spray left fire stacks on an IPC.")
	TEST_ASSERT_EQUAL(ipc.reagents.total_volume, 0, "Extinguishing allowed a spray's chemicals into the IPC body.")
	TEST_ASSERT(!ipc.IsKnockdown(), "Extinguishing allowed pepper spray's immediate effect on an IPC.")
	TEST_ASSERT(!HAS_TRAIT(ipc, TRAIT_ANOSMIA), "Extinguishing allowed pepper spray to affect an IPC's senses.")
	TEST_ASSERT(!HAS_TRAIT(ipc, TRAIT_STIMULATED), "Extinguishing allowed stimulants to affect an IPC.")
	TEST_ASSERT(!ipc.has_movespeed_modifier(/datum/movespeed_modifier/reagent/pepperspray), "Extinguishing applied pepper spray's speed modifier to an IPC.")
	TEST_ASSERT_EQUAL(ipc.AmountSleeping(), original_sleep, "Extinguishing ran water's unrelated wake-up effect.")

/// Only a positive dose of an external fire suppressant may bypass chemical immunity to put out flames.
/datum/unit_test/ipc_extinguisher_exposure_methods/Run()
	var/mob/living/carbon/human/ipc = allocate(/mob/living/carbon/human/consistent)
	ipc.set_species(/datum/species/ipc)
	var/obj/item/reagent_containers/cup/beaker/source = allocate(/obj/item/reagent_containers/cup/beaker)
	for(var/reagent_type in list(/datum/reagent/water, /datum/reagent/firefighting_foam))
		source.reagents.clear_reagents()
		source.reagents.add_reagent(reagent_type, 10)
		ipc.set_fire_stacks(5)
		TEST_ASSERT(ipc.ignite_mob(silent = TRUE), "The exposure-method fixture did not catch fire.")
		for(var/method in list(INGEST, INJECT, INHALE, PATCH))
			source.reagents.expose(ipc, method)
			TEST_ASSERT(ipc.on_fire, "Internal exposure method [method] of [reagent_type] extinguished an IPC.")
			TEST_ASSERT_EQUAL(ipc.reagents.total_volume, 0, "Internal exposure method [method] introduced suppressant into an IPC.")
		source.reagents.expose(ipc, VAPOR)
		if(reagent_type == /datum/reagent/water)
			TEST_ASSERT(ipc.on_fire, "Water vapor gained full contact extinguishing strength on an IPC.")
			source.reagents.expose(ipc, TOUCH)
		else
			TEST_ASSERT(!ipc.on_fire, "Firefighting foam vapor could not extinguish an IPC.")
		TEST_ASSERT(!ipc.on_fire, "External [reagent_type] did not extinguish the positive control.")
		TEST_ASSERT_EQUAL(ipc.reagents.total_volume, 0, "External fire suppression introduced reagents into an IPC.")

	source.reagents.clear_reagents()
	source.reagents.add_reagent(/datum/reagent/water, 10)
	var/datum/reagent/water/water = source.reagents.has_reagent(/datum/reagent/water)
	ipc.set_fire_stacks(5)
	TEST_ASSERT(ipc.ignite_mob(silent = TRUE), "The empty-dose fixture did not catch fire.")
	for(var/amount in list(0, -1))
		var/list/dose = list()
		dose[water] = amount
		ipc.expose_reagents(dose, source.reagents, TOUCH)
		TEST_ASSERT(ipc.on_fire, "A nonpositive water dose of [amount] extinguished an IPC.")
		TEST_ASSERT_EQUAL(ipc.fire_stacks, 5, "A nonpositive water dose changed an IPC's fire stacks.")

	var/obj/item/extinguisher/anti/fire_extender = allocate(/obj/item/extinguisher/anti)
	var/obj/effect/particle_effect/water/extinguisher/particle = allocate(/obj/effect/particle_effect/water/extinguisher)
	particle.create_reagents(5)
	TEST_ASSERT_EQUAL(fire_extender.reagents.trans_to(particle, 1), 1, "The fuel spray fixture could not load its particle.")
	particle.Bump(ipc)
	TEST_ASSERT(ipc.on_fire, "An extinguisher particle filled with fuel extinguished an IPC.")
	TEST_ASSERT_EQUAL(ipc.fire_stacks, 5, "A fuel spray changed fire stacks through IPC chemical immunity.")
	source.reagents.clear_reagents()
	source.reagents.add_reagent(/datum/reagent/toxin/acid, 10)
	source.reagents.expose(ipc, TOUCH)
	TEST_ASSERT(ipc.on_fire, "An unrelated chemical splash extinguished an IPC.")
	TEST_ASSERT_EQUAL(ipc.reagents.total_volume, 0, "The fire-suppression exception admitted fuel or acid into an IPC.")
