/datum/unit_test/cybernetic_rejection_implants
	abstract_type = /datum/unit_test/cybernetic_rejection_implants

/datum/unit_test/cybernetic_rejection_implants/active_and_passive/Run()
	var/mob/living/carbon/human/implantee = allocate(/mob/living/carbon/human/consistent)
	ADD_TRAIT(implantee, TRAIT_CYBERNETIC_REJECTION, REF(src))
	var/obj/item/implant/mindshield/shield = allocate(/obj/item/implant/mindshield)
	TEST_ASSERT(shield.implant(implantee, silent = TRUE), "A rejected mindshield must remain physically implantable.")
	TEST_ASSERT(shield in implantee.implants, "Rejected mindshield was not retained in the body.")
	TEST_ASSERT_EQUAL(shield.imp_in, implantee, "Rejected mindshield lost its physical host.")
	TEST_ASSERT(!HAS_TRAIT(implantee, TRAIT_MINDSHIELD), "Rejected mindshield still protects its host.")
	TEST_ASSERT(!(shield in GLOB.tracked_implants), "Rejected implant was exposed as an operating tracker.")

	var/obj/item/implant/emp/emp = allocate(/obj/item/implant/emp)
	TEST_ASSERT(emp.implant(implantee, silent = TRUE), "Rejected active implant could not be physically installed.")
	var/initial_uses = emp.uses
	emp.activate()
	TEST_ASSERT_EQUAL(emp.uses, initial_uses, "Rejected EMP implant consumed a charge.")
	for(var/datum/action/action as anything in emp.actions)
		TEST_ASSERT_NULL(action.owner, "Rejected implant granted an action to its host.")

	REMOVE_TRAIT(implantee, TRAIT_CYBERNETIC_REJECTION, REF(src))
	shield.set_cybernetic_rejection(FALSE)
	TEST_ASSERT(HAS_TRAIT(implantee, TRAIT_MINDSHIELD), "Mindshield did not reconnect after rejection was removed.")
	ADD_TRAIT(implantee, TRAIT_CYBERNETIC_REJECTION, REF(src))
	shield.set_cybernetic_rejection(TRUE)
	TEST_ASSERT(!HAS_TRAIT(implantee, TRAIT_MINDSHIELD), "An existing mindshield was not disconnected.")
	TEST_ASSERT(shield in implantee.implants, "Disconnecting a mindshield removed it from the body.")
	shield.removed(implantee, silent = TRUE)
	TEST_ASSERT_NULL(shield.imp_in, "Rejected implant could not be removed safely.")

/datum/unit_test/cybernetic_rejection_implants/storage_and_radio/Run()
	var/mob/living/carbon/human/implantee = allocate(/mob/living/carbon/human/consistent)
	ADD_TRAIT(implantee, TRAIT_CYBERNETIC_REJECTION, REF(src))
	var/obj/item/implant/storage/storage = allocate(/obj/item/implant/storage)
	TEST_ASSERT(storage.implant(implantee, silent = TRUE), "Rejected storage implant could not be physically installed.")
	TEST_ASSERT_NULL(storage.atom_storage, "Rejected storage implant created a working bluespace pocket.")
	storage.activate()
	TEST_ASSERT_NULL(storage.atom_storage, "Activating a rejected storage implant created storage.")
	var/obj/item/implant/radio/radio = allocate(/obj/item/implant/radio)
	TEST_ASSERT(radio.implant(implantee, silent = TRUE), "Rejected radio could not be physically implanted.")
	TEST_ASSERT(!radio.radio.is_on(), "Rejected radio remained powered.")
	TEST_ASSERT(!radio.radio.get_listening(), "Rejected radio still receives communications.")
	radio.radio.set_on(TRUE)
	TEST_ASSERT(!radio.radio.is_on(), "A power reset bypassed rejection on an internal radio.")

	REMOVE_TRAIT(implantee, TRAIT_CYBERNETIC_REJECTION, REF(src))
	storage.set_cybernetic_rejection(FALSE)
	radio.set_cybernetic_rejection(FALSE)
	TEST_ASSERT_NOTNULL(storage.atom_storage, "Storage did not reconnect after rejection was removed.")
	TEST_ASSERT(radio.radio.is_on() && radio.radio.get_listening(), "Radio did not reconnect after rejection was removed.")
	var/obj/item/pen/stored_item = allocate(/obj/item/pen, storage)
	var/datum/storage/previous_storage = storage.atom_storage
	ADD_TRAIT(implantee, TRAIT_CYBERNETIC_REJECTION, REF(src))
	storage.set_cybernetic_rejection(TRUE)
	TEST_ASSERT_EQUAL(stored_item.loc, storage, "Disconnecting a storage implant lost its contents.")
	TEST_ASSERT(!HAS_TRAIT(storage, TRAIT_CONTRABAND_BLOCKER), "Rejected storage implant still conceals contraband.")
	REMOVE_TRAIT(implantee, TRAIT_CYBERNETIC_REJECTION, REF(src))
	storage.set_cybernetic_rejection(FALSE)
	TEST_ASSERT_EQUAL(storage.atom_storage, previous_storage, "Reconnecting storage replaced its existing storage datum.")
	TEST_ASSERT_EQUAL(stored_item.loc, storage, "Reconnecting storage lost its contents.")

/datum/unit_test/cybernetic_rejection_implants/chem_and_tracking/Run()
	var/mob/living/carbon/human/implantee = allocate(/mob/living/carbon/human/consistent)
	ADD_TRAIT(implantee, TRAIT_CYBERNETIC_REJECTION, REF(src))
	var/obj/item/implant/chem/chem = allocate(/obj/item/implant/chem)
	chem.reagents.add_reagent(/datum/reagent/medicine/epinephrine, 10)
	TEST_ASSERT(chem.implant(implantee, silent = TRUE), "Rejected chem implant could not be physically implanted.")
	chem.activate(10)
	TEST_ASSERT_EQUAL(chem.reagents.total_volume, 10, "Rejected chem implant released its reagents.")
	var/obj/item/implant/tracking/tracker = allocate(/obj/item/implant/tracking)
	TEST_ASSERT(tracker.implant(implantee, silent = TRUE), "Rejected tracker could not be physically implanted.")
	TEST_ASSERT(!(tracker in GLOB.tracked_implants), "Rejected tracker can still be tracked.")
	var/mob/living/carbon/human/auth_implantee = allocate(/mob/living/carbon/human/consistent)
	ADD_TRAIT(auth_implantee, TRAIT_CYBERNETIC_REJECTION, REF(src))
	var/obj/item/firing_pin/implant/pindicate/pin = allocate(/obj/item/firing_pin/implant/pindicate)
	var/obj/item/implant/weapons_auth/auth = allocate(/obj/item/implant/weapons_auth)
	TEST_ASSERT(auth.implant(auth_implantee, silent = TRUE), "Rejected authentication implant could not be physically implanted.")
	TEST_ASSERT(!pin.pin_auth(auth_implantee), "Rejected implant authenticated a firearm.")
	REMOVE_TRAIT(auth_implantee, TRAIT_CYBERNETIC_REJECTION, REF(src))
	auth.set_cybernetic_rejection(FALSE)
	TEST_ASSERT(pin.pin_auth(auth_implantee), "Authentication implant did not work after reconnecting.")

/datum/unit_test/cybernetic_rejection_implants/quirk_with_existing_implants/Run()
	var/mob/living/carbon/human/implantee = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/implant/mindshield/shield = allocate(/obj/item/implant/mindshield)
	var/obj/item/implant/emp/emp = allocate(/obj/item/implant/emp)
	var/obj/item/implant/radio/radio = allocate(/obj/item/implant/radio)
	TEST_ASSERT(shield.implant(implantee, silent = TRUE), "Could not install a baseline mindshield.")
	TEST_ASSERT(emp.implant(implantee, silent = TRUE), "Could not install a baseline EMP implant.")
	TEST_ASSERT(radio.implant(implantee, silent = TRUE), "Could not install a baseline radio implant.")
	TEST_ASSERT(HAS_TRAIT(implantee, TRAIT_MINDSHIELD), "The baseline mindshield was not functioning.")
	var/list/implants = implantee.implants.Copy()
	implantee.add_quirk(/datum/quirk/cybernetic_rejection)
	for(var/obj/item/implant/implant as anything in implants)
		TEST_ASSERT(implant.cybernetic_rejection, "Adding the quirk skipped [implant.type].")
		TEST_ASSERT(implant in implantee.implants, "Adding the quirk lost [implant.type].")
	TEST_ASSERT(!HAS_TRAIT(implantee, TRAIT_MINDSHIELD), "Adding the quirk left the mindshield functioning.")
	TEST_ASSERT(!radio.radio.is_on(), "Adding the quirk left the radio functioning.")
	implantee.remove_quirk(/datum/quirk/cybernetic_rejection)
	TEST_ASSERT_EQUAL(length(implantee.implants), length(implants), "Removing the quirk changed the number of implants.")
	for(var/obj/item/implant/implant as anything in implants)
		TEST_ASSERT(!implant.cybernetic_rejection, "Removing the quirk failed to reconnect [implant.type].")
		TEST_ASSERT(implant in implantee.implants, "Removing the quirk lost [implant.type].")
	TEST_ASSERT(HAS_TRAIT(implantee, TRAIT_MINDSHIELD), "Removing the quirk failed to reconnect the mindshield.")
	TEST_ASSERT(radio.radio.is_on(), "Removing the quirk failed to reconnect the radio.")

/datum/unit_test/cybernetic_rejection_implants/uplink/Run()
	var/mob/living/carbon/human/implantee = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/implant/uplink/implant = allocate(/obj/item/implant/uplink)
	implant.uplink_handler = allocate(/datum/uplink_handler)
	TEST_ASSERT(implant.implant(implantee, silent = TRUE), "Could not install an uplink implant.")
	var/datum/component/uplink/uplink = implant.GetComponent(/datum/component/uplink)
	TEST_ASSERT_NOTNULL(uplink, "Working uplink implant did not create its component.")
	uplink.active = TRUE
	uplink.locked = FALSE
	implantee.add_quirk(/datum/quirk/cybernetic_rejection)
	TEST_ASSERT(!uplink.active && uplink.locked, "Adding the quirk left an open uplink active.")
	uplink.ui_interact(implantee)
	TEST_ASSERT(!uplink.active, "A direct UI interaction reactivated a rejected uplink.")
	TEST_ASSERT_EQUAL(uplink.ui_status(implantee, GLOB.inventory_state), UI_CLOSE, "Rejected uplink UI remained accessible.")
	implantee.remove_quirk(/datum/quirk/cybernetic_rejection)
	TEST_ASSERT_EQUAL(implant.GetComponent(/datum/component/uplink), uplink, "Reconnecting an uplink replaced its existing account.")

/datum/unit_test/cybernetic_rejection_implants/pending_explosion/Run()
	var/mob/living/carbon/human/implantee = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/implant/explosive/macro/bomb = allocate(/obj/item/implant/explosive/macro)
	bomb.delay = 4 SECONDS
	bomb.notify_ghosts = FALSE
	bomb.announce_activation = FALSE
	TEST_ASSERT(bomb.implant(implantee, silent = TRUE), "Could not install a baseline explosive implant.")
	INVOKE_ASYNC(bomb, TYPE_PROC_REF(/obj/item/implant, activate), "test")
	sleep(0.1 SECONDS)
	TEST_ASSERT(bomb.active, "Explosive implant did not begin its delayed activation.")
	implantee.add_quirk(/datum/quirk/cybernetic_rejection)
	implantee.remove_quirk(/datum/quirk/cybernetic_rejection)
	sleep(1.1 SECONDS)
	TEST_ASSERT(!implantee.IsParalyzed(), "A canceled explosion sequence paralyzed the host after reconnection.")
	TEST_ASSERT(!bomb.active, "Reconnecting an implant restarted its canceled explosion.")
	TEST_ASSERT(!QDELETED(bomb), "A canceled explosive implant was destroyed.")
