/// Rejected vital organs stay implanted but cannot be made functional by ordinary repair or processing.
/datum/unit_test/cybernetic_rejection_organs/Run()
	var/mob/living/carbon/human/holder = allocate(/mob/living/carbon/human/consistent)
	var/datum/quirk/rejection = allocate(/datum/quirk/cybernetic_rejection)
	rejection.add_to_holder(holder)
	var/obj/item/organ/heart/cybernetic/heart = allocate(/obj/item/organ/heart/cybernetic)
	TEST_ASSERT(heart.Insert(holder, special = TRUE, movement_flags = DELETE_IF_REPLACED), "An incompatible cybernetic heart could not be physically implanted.")
	TEST_ASSERT_EQUAL(holder.get_organ_slot(ORGAN_SLOT_HEART), heart, "The rejected heart is missing from its organ slot.")
	TEST_ASSERT_EQUAL(heart.bodypart_owner, holder.get_bodypart(BODY_ZONE_CHEST), "The rejected heart is missing its chest ownership.")
	TEST_ASSERT(heart.cybernetic_rejection, "The cybernetic heart was not rejected.")
	TEST_ASSERT(heart.organ_flags & ORGAN_FAILING, "The rejected cybernetic heart still works.")
	TEST_ASSERT_EQUAL(heart.damage, 0, "Cybernetic rejection inflicted permanent damage on the heart.")
	TEST_ASSERT_EQUAL(heart.get_blood_regeneration_multiplier(), 0, "The rejected heart can still regenerate blood.")
	heart.apply_organ_damage(-heart.maxHealth)
	holder.handle_organs(1)
	TEST_ASSERT(heart.organ_flags & ORGAN_FAILING, "Repair or organ processing bypassed cybernetic rejection.")

	heart.Remove(holder, special = TRUE)
	heart.forceMove(run_loc_floor_bottom_left)
	var/mob/living/carbon/human/recipient = allocate(/mob/living/carbon/human/consistent)
	TEST_ASSERT(heart.Insert(recipient, special = TRUE, movement_flags = DELETE_IF_REPLACED), "A compatible recipient could not receive the extracted heart.")
	TEST_ASSERT(!heart.cybernetic_rejection, "The heart remained rejected in a compatible recipient.")
	TEST_ASSERT(!(heart.organ_flags & ORGAN_FAILING), "The undamaged heart remained broken after transplantation.")
	TEST_ASSERT(heart.get_blood_regeneration_multiplier() > 0, "The transplanted heart did not resume functioning.")

/// Rejected sensory replacements remove vision and hearing even when installed as a special hot swap.
/datum/unit_test/cybernetic_rejection_senses/Run()
	var/mob/living/carbon/human/holder = allocate(/mob/living/carbon/human/consistent)
	var/datum/quirk/rejection = allocate(/datum/quirk/cybernetic_rejection)
	rejection.add_to_holder(holder)
	var/obj/item/organ/eyes/robotic/eyes = allocate(/obj/item/organ/eyes/robotic)
	var/obj/item/organ/ears/cybernetic/ears = allocate(/obj/item/organ/ears/cybernetic)
	TEST_ASSERT(eyes.Insert(holder, special = TRUE, movement_flags = DELETE_IF_REPLACED), "Cybernetic eyes could not be physically installed.")
	TEST_ASSERT(ears.Insert(holder, special = TRUE, movement_flags = DELETE_IF_REPLACED), "Cybernetic ears could not be physically installed.")
	TEST_ASSERT(holder.is_blind(), "The holder can still see through rejected cybernetic eyes.")
	TEST_ASSERT(HAS_TRAIT(holder, TRAIT_DEAF), "The holder can still hear through rejected cybernetic ears.")
	rejection.remove_from_current_holder()
	TEST_ASSERT(!holder.is_blind(), "Removing rejection did not restore undamaged cybernetic eyes.")
	TEST_ASSERT(!HAS_TRAIT(holder, TRAIT_DEAF), "Removing rejection did not restore undamaged cybernetic ears.")

	var/datum/quirk/organic_rejection = allocate(/datum/quirk/cybernetic_rejection)
	organic_rejection.add_to_holder(holder)
	var/obj/item/organ/eyes/lizard/organic_eyes = allocate(/obj/item/organ/eyes/lizard)
	TEST_ASSERT(organic_eyes.Insert(holder, special = TRUE, movement_flags = DELETE_IF_REPLACED), "Organic eyes from another species could not be transplanted.")
	TEST_ASSERT(!organic_eyes.cybernetic_rejection, "The holder rejected an organic transplant from another species.")
	TEST_ASSERT(!(organic_eyes.organ_flags & ORGAN_FAILING), "Organic transplanted eyes became nonfunctional.")
	TEST_ASSERT(!holder.is_blind(), "Organic transplanted eyes did not restore vision.")

/// Adding and removing the quirk must suspend existing passive bonuses and actions exactly once.
/datum/unit_test/cybernetic_rejection_existing_augments/Run()
	var/mob/living/carbon/human/holder = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/bodypart/arm = holder.get_bodypart(BODY_ZONE_R_ARM)
	var/base_damage = arm.unarmed_damage_high
	var/obj/item/organ/cyberimp/arm/strongarm/muscle = allocate(/obj/item/organ/cyberimp/arm/strongarm)
	var/obj/item/organ/cyberimp/eyes/hud/medical/hud = allocate(/obj/item/organ/cyberimp/eyes/hud/medical)
	TEST_ASSERT(muscle.Insert(holder, special = TRUE), "The compatible holder could not receive a Strong-Arm implant.")
	TEST_ASSERT(hud.Insert(holder, special = TRUE), "The compatible holder could not receive a medical HUD.")
	var/datum/action/action = hud.actions[1]
	TEST_ASSERT_EQUAL(arm.unarmed_damage_high, base_damage + muscle.upper_punch_damage, "The installed Strong-Arm implant did not grant its baseline bonus.")
	TEST_ASSERT(HAS_TRAIT(holder, TRAIT_MEDICAL_HUD), "The medical HUD did not grant its baseline HUD trait.")
	TEST_ASSERT_EQUAL(action.owner, holder, "The medical HUD did not grant its baseline action.")

	var/datum/quirk/rejection = allocate(/datum/quirk/cybernetic_rejection)
	rejection.add_to_holder(holder)
	TEST_ASSERT_EQUAL(arm.unarmed_damage_high, base_damage, "A rejected Strong-Arm implant still increases punch damage.")
	TEST_ASSERT(!HAS_TRAIT(holder, TRAIT_MEDICAL_HUD), "The rejected medical HUD still grants its HUD trait.")
	TEST_ASSERT_NULL(action.owner, "The rejected medical HUD still grants its action.")
	TEST_ASSERT_EQUAL(muscle.owner, holder, "Rejecting an existing augment detached it from its owner.")
	TEST_ASSERT_EQUAL(muscle.bodypart_owner, arm, "Rejecting an existing augment lost its limb ownership.")

	rejection.remove_from_current_holder()
	TEST_ASSERT_EQUAL(arm.unarmed_damage_high, base_damage + muscle.upper_punch_damage, "Removing rejection did not restore exactly one Strong-Arm bonus.")
	TEST_ASSERT(HAS_TRAIT(holder, TRAIT_MEDICAL_HUD), "Removing rejection did not restore the medical HUD.")
	TEST_ASSERT_EQUAL(action.owner, holder, "Removing rejection did not restore the medical HUD action.")

/// A passive implant whose on_life lacks its own failure check must still remain inactive.
/datum/unit_test/cybernetic_rejection_passive_implant/Run()
	var/mob/living/carbon/human/holder = allocate(/mob/living/carbon/human/consistent)
	var/datum/quirk/rejection = allocate(/datum/quirk/cybernetic_rejection)
	rejection.add_to_holder(holder)
	var/obj/item/organ/cyberimp/chest/nutriment/pump = allocate(/obj/item/organ/cyberimp/chest/nutriment)
	TEST_ASSERT(pump.Insert(holder, special = TRUE), "The nutriment pump could not be physically installed.")
	holder.set_nutrition(1)
	holder.handle_organs(1)
	TEST_ASSERT(holder.nutrition <= 1, "A rejected nutriment pump still fed its owner.")
	TEST_ASSERT(!pump.synthesizing, "The rejected nutriment pump activated its synthesis cycle.")
	rejection.remove_from_current_holder()
	holder.handle_organs(1)
	TEST_ASSERT(holder.nutrition > 1, "The nutriment pump did not resume feeding after rejection was removed.")

/// Skillchips installed in an organic brain still count as cybernetics.
/datum/unit_test/cybernetic_rejection_skillchips/Run()
	var/mob/living/carbon/human/holder = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/skillchip/basketweaving/chip = allocate(__IMPLIED_TYPE__)
	holder.implant_skillchip(chip, force = TRUE)
	chip.try_activate_skillchip(silent = TRUE, force = TRUE)
	TEST_ASSERT(chip.active, "The baseline skillchip did not activate.")
	var/list/chip_metadata = chip.get_metadata()
	holder.add_quirk(/datum/quirk/cybernetic_rejection)
	TEST_ASSERT(!chip.active, "Adding rejection left an existing skillchip active.")
	TEST_ASSERT_NOTNULL(chip.holding_brain, "Rejection physically removed the skillchip.")
	chip.try_activate_skillchip(silent = TRUE, force = TRUE)
	TEST_ASSERT(!chip.active, "Forced activation bypassed skillchip rejection.")
	chip.set_metadata(chip_metadata)
	TEST_ASSERT(!chip.active, "Restoring skillchip metadata bypassed rejection.")
	holder.remove_quirk(/datum/quirk/cybernetic_rejection)
	chip.try_activate_skillchip(silent = TRUE, force = TRUE)
	TEST_ASSERT(chip.active, "The skillchip could not be activated after removing rejection.")
