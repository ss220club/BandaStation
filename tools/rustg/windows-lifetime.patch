+
+// Rayon and async workers can outlive a BYOND world. Windows must keep their
+// code and TLS destructors mapped until the host process terminates.
+#[cfg(windows)]
+pub fn ensure_module_lifetime() -> bool {
+    use std::{ffi::c_void, sync::OnceLock};
+
+    #[link(name = "kernel32")]
+    unsafe extern "system" {
+        #[link_name = "GetModuleHandleExW"]
+        fn get_module_handle_ex_w(flags: u32, address: *const u16, module: *mut *mut c_void) -> i32;
+    }
+
+    static PINNED: OnceLock<bool> = OnceLock::new();
+    *PINNED.get_or_init(|| {
+        const FROM_ADDRESS: u32 = 0x00000004;
+        const PIN: u32 = 0x00000001;
+        let mut module = std::ptr::null_mut();
+        // SAFETY: FROM_ADDRESS interprets this pointer as a code address, not a
+        // string. This executing function is inside the DLL being pinned.
+        unsafe {
+            get_module_handle_ex_w(
+                FROM_ADDRESS | PIN,
+                ensure_module_lifetime as *const () as *const u16,
+                &mut module,
+            ) != 0
+        }
+    })
+}
+
+#[cfg(not(windows))]
+pub fn ensure_module_lifetime() -> bool {
+    true
+}
 
